# Database
DATABASE_URL=postgres://omnichannel:secret@localhost:5432/omnichannel_fms?sslmode=disable
DB_PASSWORD=secret

# Redis
REDIS_URL=redis://:redissecret@localhost:6379/0
REDIS_PASSWORD=redissecret

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Server
PORT=8080
GIN_MODE=debug

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=omnichannel-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# AI (OpenAI / Gemini)
OPENAI_API_KEY=sk-...your-key-here...
GEMINI_API_KEY=...your-gemini-key...

# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Tokopedia
TOKOPEDIA_CLIENT_ID=
TOKOPEDIA_CLIENT_SECRET=

# Lazada
LAZADA_CLIENT_ID=
LAZADA_CLIENT_SECRET=

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# Blibli
BLIBLI_CLIENT_ID=
BLIBLI_CLIENT_SECRET=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# MinIO root credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Development
MOCK_MARKETPLACE=true
ENABLE_SWAGGER=true
LOG_LEVEL=debug
